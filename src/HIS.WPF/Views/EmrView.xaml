<UserControl x:Class="HIS.WPF.Views.EmrView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 당일 대기/진료중 목록 -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="진료 대기 환자 (클릭 시 진료 시작)" FontWeight="Bold" Margin="0,0,0,8"/>
            <DataGrid ItemsSource="{Binding TodayVisits}" SelectedItem="{Binding SelectedEmrVisit}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="차트" Binding="{Binding ChartNo}" Width="85"/>
                    <DataGridTextColumn Header="성명" Binding="{Binding PatientName}" Width="80"/>
                    <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="70"/>
                    <DataGridTextColumn Header="의사" Binding="{Binding DoctorName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- 우측: SOAP 차트 + 바이탈 + 처방 오더 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 바이탈 & 주상병 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="주상병(KCD):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding Diseases}" SelectedValue="{Binding SelectedKcdCode}"
                          SelectedValuePath="KcdCode" DisplayMemberPath="NameKr" Width="220" Height="28" Margin="0,0,14,0"/>
                <TextBlock Text="수축기BP:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Text="{Binding SystolicBP}" Width="50" Height="28" Margin="0,0,8,0"/>
                <TextBlock Text="이완기BP:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Text="{Binding DiastolicBP}" Width="50" Height="28" Margin="0,0,8,0"/>
                <TextBlock Text="체온:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Text="{Binding Temperature}" Width="50" Height="28"/>
            </StackPanel>

            <!-- SOAP 입력 -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                    <TextBlock Text="S (Subjective - 주호소)" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Subjective}" Height="56" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                    <TextBlock Text="O (Objective - 객관적 소견)" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Objective}" Height="56" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="A (Assessment - 평가/진단)" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Assessment}" Height="56" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="P (Plan - 치료 계획)" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding PlanNote}" Height="56" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
            </Grid>

            <!-- 처방 오더 (OCS) -->
            <DockPanel Grid.Row="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="처방 추가:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding OrderMasters}" SelectedItem="{Binding SelectedOrderMaster}"
                              DisplayMemberPath="OrderName" Width="280" Height="28" Margin="0,0,8,0"/>
                    <Button Content="오더 추가" Command="{Binding AddOrderCommand}" Padding="12,4" Background="#1D4ED8" Foreground="White" BorderThickness="0"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding CurrentOrders}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="코드" Binding="{Binding OrderCode}" IsReadOnly="True" Width="85"/>
                        <DataGridTextColumn Header="구분" Binding="{Binding OrderType}" IsReadOnly="True" Width="65"/>
                        <DataGridTextColumn Header="처방명" Binding="{Binding OrderName}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="단가" Binding="{Binding UnitPrice, StringFormat=N0}" IsReadOnly="True" Width="80"/>
                        <DataGridCheckBoxColumn Header="급여" Binding="{Binding IsCovered}" IsReadOnly="True" Width="50"/>
                        <DataGridTextColumn Header="용량" Binding="{Binding Dosage}" Width="55"/>
                        <DataGridTextColumn Header="횟수" Binding="{Binding Frequency}" Width="55"/>
                        <DataGridTextColumn Header="일수" Binding="{Binding Days}" Width="55"/>
                        <DataGridTemplateColumn Header="삭제" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="삭제" Command="{Binding DataContext.RemoveOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="6,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Button Grid.Row="3" Content="진료 저장 및 처방 전송 (수납대기 전환)" Command="{Binding CompleteConsultationCommand}"
                    Height="38" Margin="0,10,0,0" Background="#0F766E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        </Grid>
    </Grid>
</UserControl>
