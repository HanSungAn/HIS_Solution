<UserControl x:Class="HIS.WPF.Views.PaymentHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 검색 필터 영역 -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="조회 기간:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="0,0,6,0"/>
                <TextBlock Text="~" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="0,0,16,0"/>

                <TextBlock Text="결제수단:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding PayMethods}" SelectedItem="{Binding SelectedPayMethod}" Width="105" Height="28" Margin="0,0,16,0"/>

                <TextBlock Text="검색어:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="210" Height="28" Padding="6,4"
                         ToolTip="환자명, 차트번호 또는 영수증번호" Margin="0,0,10,0"/>

                <Button Content="조회" Command="{Binding SearchCommand}" Padding="16,5" Background="#1D4ED8" Foreground="White"
                        BorderThickness="0" FontWeight="SemiBold" Margin="0,0,6,0"/>
                <Button Content="초기화" Command="{Binding ResetFilterCommand}" Padding="12,5" Background="#64748B" Foreground="White"
                        BorderThickness="0" Margin="0,0,6,0"/>
                <Button Content="엑셀 저장" Command="{Binding ExportExcelCommand}" Padding="14,5" Background="#15803D" Foreground="White"
                        BorderThickness="0" FontWeight="SemiBold"/>
            </WrapPanel>
        </Border>

        <!-- 집계 요약 영역 -->
        <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding TotalCount, StringFormat='조회 건수: {0:N0} 건'}" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding SumTotalAmount, StringFormat='총 진료비: {0:N0} 원'}" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding SumCoveredAmount, StringFormat='급여 합계: {0:N0} 원'}" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding SumNonCoveredAmount, StringFormat='비급여 합계: {0:N0} 원'}" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding SumPatientPaidAmount, StringFormat='본인부담금(수납액) 합계: {0:N0} 원'}" FontWeight="Bold" Foreground="#DC2626"/>
            </StackPanel>
        </Border>

        <!-- 좌측: 수납 이력 목록 / 우측: 선택 이력 상세 및 처방 내역 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding PaymentHistories}"
                      SelectedItem="{Binding SelectedHistory}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="수납일시" Binding="{Binding OccurredAt, StringFormat=yyyy-MM-dd HH:mm}" Width="125"/>
                    <DataGridTextColumn Header="영수증번호" Binding="{Binding ReceiptNo}" Width="135"/>
                    <DataGridTextColumn Header="구분" Binding="{Binding ActionType}" Width="65"/>
                    <DataGridTextColumn Header="차트번호" Binding="{Binding ChartNo}" Width="90"/>
                    <DataGridTextColumn Header="환자명" Binding="{Binding PatientName}" Width="80"/>
                    <DataGridTextColumn Header="보험" Binding="{Binding InsuranceType}" Width="55"/>
                    <DataGridTextColumn Header="총진료비" Binding="{Binding TotalAmount, StringFormat=N0}" Width="85"/>
                    <DataGridTextColumn Header="본인부담금" Binding="{Binding PatientPaidAmount, StringFormat=N0}" Width="90"/>
                    <DataGridTextColumn Header="결제수단" Binding="{Binding PayMethod}" Width="75"/>
                    <DataGridTextColumn Header="수납자" Binding="{Binding CashierName}" Width="75"/>
                    <DataGridTextColumn Header="비고" Binding="{Binding Memo}" Width="Auto" MinWidth="180"/>
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Column="2" Header="선택 수납 내역 상세" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{Binding SelectedHistory.ReceiptNo, StringFormat='영수증 번호: {0}', FallbackValue='이력을 선택하세요.'}"
                                   FontSize="15" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SelectedHistory.PatientName, StringFormat='환자명: {0}'}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedHistory.ChartNo, StringFormat='차트번호: {0}'}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedHistory.DoctorName, StringFormat='담당의: {0}'}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedHistory.TotalAmount, StringFormat='총 진료비: {0:N0} 원'}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedHistory.CoveredAmount, StringFormat='급여 항목: {0:N0} 원'}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedHistory.NonCoveredAmount, StringFormat='비급여 항목: {0:N0} 원'}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedHistory.PatientPaidAmount, StringFormat='본인부담금(수납액): {0:N0} 원'}"
                                   FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedHistory.CashierName, StringFormat='수납 담당자: {0}'}" Margin="0,0,0,4"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="상세 처방 / 진료비 산정 내역" FontWeight="Bold" Margin="0,4,0,6"/>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding SelectedVisitOrders}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="코드" Binding="{Binding OrderCode}" Width="75"/>
                            <DataGridTextColumn Header="항목명" Binding="{Binding OrderName}" Width="*"/>
                            <DataGridCheckBoxColumn Header="급여" Binding="{Binding IsCovered}" Width="45"/>
                            <DataGridTextColumn Header="단가" Binding="{Binding UnitPrice, StringFormat=N0}" Width="75"/>
                            <DataGridTextColumn Header="금액" Binding="{Binding LineTotal, StringFormat=N0}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
