<UserControl x:Class="HIS.WPF.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 검색 필터 영역 -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="조회 기간:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="0,0,6,0"/>
                <TextBlock Text="~" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="0,0,16,0"/>

                <TextBlock Text="이력 구분:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding ActionTypeOptions}" SelectedItem="{Binding SelectedActionFilter}"
                          DisplayMemberPath="Label" Width="170" Height="28" Margin="0,0,16,0"/>

                <TextBlock Text="검색어:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="190" Height="28" Padding="6,4"
                         ToolTip="사용자명, 모듈명 또는 상세 내용" Margin="0,0,10,0"/>

                <Button Content="조회" Command="{Binding SearchCommand}" Padding="16,5" Background="#1D4ED8" Foreground="White"
                        BorderThickness="0" FontWeight="SemiBold" Margin="0,0,6,0"/>
                <Button Content="초기화" Command="{Binding ResetFilterCommand}" Padding="12,5" Background="#64748B" Foreground="White"
                        BorderThickness="0"/>
            </WrapPanel>
        </Border>

        <!-- 빠른 조회 메뉴바 (로그인 / 로그아웃 / 엑셀 다운로드 등) -->
        <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="빠른 조회:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,0,10,0"/>
                    <Button Content="전체" Command="{Binding QuickFilterCommand}" CommandParameter="{x:Null}"
                            Padding="10,4" Margin="0,0,6,0" Background="White" BorderBrush="#93C5FD" BorderThickness="1"/>
                    <Button Content="로그인 이력" Command="{Binding QuickFilterCommand}" CommandParameter="Login"
                            Padding="10,4" Margin="0,0,6,0" Background="White" BorderBrush="#93C5FD" BorderThickness="1"/>
                    <Button Content="로그아웃 이력" Command="{Binding QuickFilterCommand}" CommandParameter="Logout"
                            Padding="10,4" Margin="0,0,6,0" Background="White" BorderBrush="#93C5FD" BorderThickness="1"/>
                    <Button Content="엑셀 다운로드 이력" Command="{Binding QuickFilterCommand}" CommandParameter="Export"
                            Padding="10,4" Margin="0,0,6,0" Background="White" BorderBrush="#93C5FD" BorderThickness="1"/>
                    <Button Content="조회(EMR)" Command="{Binding QuickFilterCommand}" CommandParameter="View"
                            Padding="10,4" Margin="0,0,6,0" Background="White" BorderBrush="#93C5FD" BorderThickness="1"/>
                    <Button Content="등록(Create)" Command="{Binding QuickFilterCommand}" CommandParameter="Create"
                            Padding="10,4" Margin="0,0,6,0" Background="White" BorderBrush="#93C5FD" BorderThickness="1"/>
                    <Button Content="수정(Update)" Command="{Binding QuickFilterCommand}" CommandParameter="Update"
                            Padding="10,4" Background="White" BorderBrush="#93C5FD" BorderThickness="1"/>
                </StackPanel>
                <TextBlock Text="{Binding TotalCount, StringFormat='조회 건수: {0:N0} 건'}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E3A5F"/>
            </DockPanel>
        </Border>

        <!-- 감사 로그 목록 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding AuditLogs}" AutoGenerateColumns="False" IsReadOnly="True"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="일시" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="145"/>
                <DataGridTextColumn Header="사용자" Binding="{Binding UserName}" Width="100"/>
                <DataGridTextColumn Header="행위" Binding="{Binding ActionType}" Width="80"/>
                <DataGridTextColumn Header="모듈" Binding="{Binding TargetModule}" Width="110"/>
                <DataGridTextColumn Header="환자ID" Binding="{Binding TargetPatientId}" Width="70"/>
                <DataGridTextColumn Header="상세 내용" Binding="{Binding Detail}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
