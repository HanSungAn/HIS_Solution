<UserControl x:Class="HIS.WPF.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="수납 대기 목록 (PayWait)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
            <DataGrid ItemsSource="{Binding PayWaitVisits}" SelectedItem="{Binding SelectedPayVisit}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="접수번호" Binding="{Binding VisitId}" Width="75"/>
                    <DataGridTextColumn Header="차트번호" Binding="{Binding ChartNo}" Width="100"/>
                    <DataGridTextColumn Header="환자명" Binding="{Binding PatientName}" Width="90"/>
                    <DataGridTextColumn Header="보험" Binding="{Binding InsuranceType}" Width="65"/>
                    <DataGridTextColumn Header="담당의" Binding="{Binding DoctorName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <GroupBox Grid.Column="2" Header="진료비 산정 및 수납" Padding="16">
            <StackPanel>
                <TextBlock Text="{Binding SelectedPayVisit.PatientName, StringFormat='수납 대상: {0}', FallbackValue='수납 대기 환자를 선택하세요.'}"
                           FontSize="16" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding PaymentPreview.TotalAmount, StringFormat='총 진료비: {0:N0} 원'}" FontSize="14" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding PaymentPreview.CoveredAmount, StringFormat='급여 항목: {0:N0} 원'}" FontSize="14" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding PaymentPreview.NonCoveredAmount, StringFormat='비급여 항목: {0:N0} 원'}" FontSize="14" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding PaymentPreview.PatientPaidAmount, StringFormat='본인부담금(수납액): {0:N0} 원'}"
                           FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,16"/>

                <TextBlock Text="결제 수단 (Card / Cash / Transfer)" Margin="0,0,0,4"/>
                <TextBox Text="{Binding PayMethod}" Height="30" Padding="6,4" Margin="0,0,0,14"/>

                <Button Content="수납 완료 처리" Command="{Binding ProcessPaymentCommand}"
                        Height="40" Background="#1D4ED8" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
