<Window x:Class="HIS.WPF.Views.ExcelExportReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="엑셀 다운로드 사유 입력" Height="250" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Border Margin="16" Padding="18" Background="White" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="수납 이력 엑셀 다운로드 사유" FontSize="15" FontWeight="Bold" Foreground="#1E3A5F"/>
                <TextBlock Text="개인정보 보호를 위해 다운로드 사유가 감사 이력에 기록됩니다." FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
            </StackPanel>

            <TextBox x:Name="ReasonBox" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Padding="8" FontSize="13"
                     ToolTip="예: 월말 정산 보고, 건강보험 청구 확인 등"/>

            <TextBlock x:Name="WarningText" Grid.Row="2" Text="" Foreground="#DC2626" FontSize="12" Height="18" Margin="0,6,0,6"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" IsCancel="True" Width="80" Height="32" Margin="0,0,8,0"
                        Background="#E2E8F0" Foreground="#334155" BorderThickness="0"/>
                <Button Content="확인" IsDefault="True" Width="90" Height="32" Click="ConfirmButton_Click"
                        Background="#1D4ED8" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
